# periplus — environment example
# Copy to bridge/.env and dashboard/.env (or .env.local) and fill in values.
# NEVER commit the real .env file. Keys here are placeholders.

# --- Supabase project: periplus (ref: lvvulorcvuxuyrnumfay) ---
SUPABASE_URL=https://lvvulorcvuxuyrnumfay.supabase.co

# Public anon key (safe for client + bridge in this MVP). Get it from:
# Supabase Dashboard -> Project Settings -> API -> Project API keys -> anon public
SUPABASE_ANON_KEY=

# --- Gateway auth (MVP-level, not production security) ---
# The ingest key of the gateway this bridge is plugged into. Must hash to a row
# in public.devices(ingest_key_hash). This is a SHARED SECRET — anyone holding
# it can write readings as that gateway, since the anon key above is public by
# design. Never commit a real value here.
#
# register_device() prints a generated key ONCE; it is stored only as a hash and
# cannot be read back. If lost, re-run register_device to rotate it.
#
# Cellular tags do NOT use this file — each holds its own key in its config.h.
GATEWAY_KEY=

# --- Serial port for the bridge (where the gateway is plugged in) ---
# macOS:   /dev/tty.usbmodemXXXX  or  /dev/tty.SLAB_USBtoUART
# Linux:   /dev/ttyACM0  or  /dev/ttyUSB0
# Windows: COM3
SERIAL_PORT=/dev/tty.usbmodemXXXX
SERIAL_BAUD=115200

# --- Dashboard (Vite) needs the VITE_ prefixed variants ---
VITE_SUPABASE_URL=https://lvvulorcvuxuyrnumfay.supabase.co
VITE_SUPABASE_ANON_KEY=
