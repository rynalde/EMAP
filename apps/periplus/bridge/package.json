{
  "name": "periplus-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "USB serial -> Supabase bridge for periplus",
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "dev:node": "node --experimental-strip-types src/index.ts",
    "mock": "MOCK_SERIAL=1 bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "serialport": "^12.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
